# --- Discord ---
DISCORD_TOKEN=
# Prefix for text commands (slash commands always work)
PREFIX=!

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/turtle

# --- Status panels ---
# Seconds between status panel refreshes (10–3600)
STATUS_INTERVAL_SECONDS=30

# --- Minecraft chat bridge (Mineflayer) ---
# Set to false to run without the in-game bridge bot
MC_BRIDGE_ENABLED=true
MC_SERVER_HOST=127.0.0.1
MC_JAVA_PORT=25565
MC_BOT_USERNAME=DiscordBridge
# offline (cracked / Geyser proxies) or microsoft (premium account)
MC_BOT_AUTH=offline

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
